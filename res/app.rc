#include <winver.h>

#define STR2(x) #x
#define STR(x) STR2(x)
#define APP_VERSION_STR STR(APP_VERSION_MAJOR) "." STR(APP_VERSION_MINOR) "." STR(APP_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
FILEVERSION    APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "FileDescription", "Taskbar Media Player"
            VALUE "FileVersion",     APP_VERSION_STR
            VALUE "ProductName",     "Taskbar Media Player"
            VALUE "ProductVersion",  APP_VERSION_STR
            VALUE "OriginalFilename", "taskbar-mediaplayer.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
